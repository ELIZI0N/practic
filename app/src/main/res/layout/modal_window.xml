<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="200dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="20dp"
    android:layout_marginTop="80dp"
    android:background="@drawable/modal_background"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Сортировка"
        android:textColor="#1F1F39"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/sortById"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:background="@drawable/sort_button_background"
        android:text="По дате добавления (новые → старые)"
        android:textAllCaps="false"
        android:textColor="#1F1F39"
        android:textSize="14sp" />

    <Button
        android:id="@+id/sortByRelease"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:background="@drawable/sort_button_background"
        android:text="По дате релиза (новые → старые)"
        android:textAllCaps="false"
        android:textColor="#1F1F39"
        android:textSize="14sp" />

    <Button
        android:id="@+id/sortByViews"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:background="@drawable/sort_button_background"
        android:text="По просмотрам (больше → меньше)"
        android:textAllCaps="false"
        android:textColor="#1F1F39"
        android:textSize="14sp" />

    <Button
        android:id="@+id/sortByChapters"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:background="@drawable/sort_button_background"
        android:text="По количеству глав (больше → меньше)"
        android:textAllCaps="false"
        android:textColor="#1F1F39"
        android:textSize="14sp" />

    <Button
        android:id="@+id/sortByScore"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:background="@drawable/sort_button_background"
        android:text="По рейтингу (высокий → низкий)"
        android:textAllCaps="false"
        android:textColor="#1F1F39"
        android:textSize="14sp" />

    <Button
        android:id="@+id/sortByPopularity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/sort_button_background"
        android:text="По популярности (высокая → низкая)"
        android:textAllCaps="false"
        android:textColor="#1F1F39"
        android:textSize="14sp" />

</LinearLayout>