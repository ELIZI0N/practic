<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#FFFFFF"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="8dp"
    >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:background="#FFFFFF"
        android:orientation="horizontal">

        <androidx.cardview.widget.CardView
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:layout_margin="14dp"
            app:cardCornerRadius="8dp">

            <ImageView
                android:id="@+id/manga_img_stolb"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:layout_marginStart="21dp"
            android:layout_marginTop="13dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/manga_title_stolb"
                android:layout_width="match_parent"
                android:layout_height="21dp"
                android:fontFamily="@font/poppins_500"
                android:text="Title"
                android:textColor="#1F1F39"
                android:textSize="14sp"
                app:lineHeight="21dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="18dp"
                android:layout_marginTop="2dp"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/imageView2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="3dp"
                    android:backgroundTint="#00FFFFFF"
                    app:srcCompat="@drawable/people" />

                <TextView
                    android:id="@+id/author_manga_stolb"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fontFamily="@font/poppins_400"
                    android:text="Author"
                    android:textColor="#B8B8D2"
                    android:textSize="12sp"
                    app:lineHeight="18dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:background="@drawable/chapter_background"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/all_recycler"
                    android:layout_width="wrap_content"
                    android:layout_height="15dp"
                    android:layout_marginStart="5dp"
                    android:fontFamily="@font/poppins_400"
                    android:text="Chapters"
                    android:textColor="#FF6905"
                    android:textSize="10sp"
                    app:lineHeight="15dp" />

                <Space
                    android:layout_width="5dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/textView8"
                    android:layout_width="wrap_content"
                    android:layout_height="15dp"
                    android:layout_marginEnd="5dp"
                    android:fontFamily="@font/poppins_400"
                    android:text="глав"
                    android:textColor="#FF6905"
                    android:textSize="10sp"
                    app:lineHeight="15dp" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
